# 운영 서버의 /etc/systemd/system/stelline-db-backup.service 원본. 서버에서만 고치지 말고 여기도 함께 고친다.
#
# 운영 DB 를 덤프해 ~/backup/db/ 에 남긴다(deploy/db-backup.sh, 서버의 ~/db-backup.sh).
# 같은 이름의 .timer 가 매일 부른다. 직접 한 번 돌리려면: sudo systemctl start stelline-db-backup
#
# - 스크립트는 저장소 안이 아니라 홈의 사본을 부른다. 배포(git pull)가 중간에 깨져도 백업은 따로 돈다.
# - DB 접속 정보는 앱과 같은 .env 에서 읽는다. 앱처럼 ubuntu 사용자로 돌아 로그·백업 파일 주인도 같다.
#
# 설치: README.md 의 'DB 백업'
[Unit]
Description=Daily dump of the stelline MySQL database
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/home/ubuntu/stelline/.env
ExecStart=/bin/bash /home/ubuntu/db-backup.sh
# 덤프는 몇 초면 끝난다. DB 가 응답하지 않아 걸려 있으면 끊고 실패로 남긴다.
TimeoutStartSec=15min
# 앱이 받는 요청보다 뒤로 미룬다.
Nice=10
IOSchedulingClass=idle
