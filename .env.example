# 운영 환경용. 이 파일을 .env로 복사한 뒤 실제 값으로 채우세요.
APP_ENV=production
RDS_HOST=
RDS_PORT=3306
RDS_USER=
RDS_PASSWORD=
RDS_DB=stelline
SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 사용자 제보(검색어 제안·번호 제보·누락 제보)의 캡차 검증 키. 비우면 제보가 모두 캡차 단계에서 거절된다.
TURNSTILE_SECRET_KEY=
API_KEY=
PLAYLIST_ID=
SEARCH_API_KEY=
TEMP_API_KEY=
NCP_CLIENT_ID=
NCP_CLIENT_SECRET=
SERVICE_ACCOUNT_FILE=
PROJECT_ID=
ADMIN_HTML_SNAPSHOT_PATH=
AUTO_CREATE_SCHEMA=false
# 관리자 세션 쿠키를 https 에서만 보낸다. http 로 관리자에 들어가야 할 때만 false.
SESSION_COOKIE_SECURE=true
START_BACKGROUND_TASKS=true
