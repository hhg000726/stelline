# 운영 서버의 /etc/systemd/system/stelline-standby.service 원본. 대기 서버(핫 스탠바이)다.
# 서버에서만 고치지 말고 여기도 함께 고친다. 배포 때 자동으로 설치되지 않는다(README 의 '앱 프로세스').
#
# - 본 서버(stelline.service, 5000)와 같은 코드·같은 .env 로 127.0.0.1:5001 에 뜬다.
#   평소에는 요청을 받지 않는다. nginx 가 본 서버에 연결하지 못할 때만 이쪽으로 보낸다(deploy/nginx).
# - 백그라운드 작업(조회수 감시·검색 점검·Bugs 순위)은 돌리지 않는다. 본 서버만 돌린다.
#   대기 서버가 먼저 잠금을 잡으면 작업 로그가 본 서버의 logs/ 에 남지 않아 관리자 화면 '운영 로그'가 비고,
#   본 서버가 배포로 다시 뜰 때마다 작업을 맡는 쪽이 바뀌게 된다.
# - 로그는 따로 쌓는다(logs/standby/). 같은 파일을 두 프로세스가 저마다 자정에 넘기면 서로의 파일을 덮어쓴다.
#
# 설치: sudo install -m 644 deploy/systemd/stelline-standby.service /etc/systemd/system/stelline-standby.service
#       sudo systemctl daemon-reload && sudo systemctl enable --now stelline-standby
[Unit]
Description=Gunicorn hot standby instance to serve stelline
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/stelline
Environment=START_BACKGROUND_TASKS=false
Environment=LOG_DIR=/home/ubuntu/stelline/logs/standby
ExecStart=/home/ubuntu/stelline/venv/bin/gunicorn --workers 1 --bind 127.0.0.1:5001 stelline:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
