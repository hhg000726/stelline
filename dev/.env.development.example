# 개발 전용 DB 설정. 운영 RDS 자격 증명과 키를 이 파일에 넣지 마세요.
APP_ENV=development
RDS_HOST=127.0.0.1
RDS_PORT=3307
RDS_USER=stelline_dev
RDS_PASSWORD=stelline_dev_password
RDS_DB=stelline_dev
SECRET_KEY=change-this-development-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# 제보 캡차 검증 키. 비워 두면 개발에서는 제보가 모두 캡차 단계에서 거절된다.
TURNSTILE_SECRET_KEY=
AUTO_CREATE_SCHEMA=true
# 외부 API 호출·푸시 발송은 개발에서 기본 차단합니다.
START_BACKGROUND_TASKS=false
API_KEY=
PLAYLIST_ID=
SEARCH_API_KEY=
TEMP_API_KEY=
NCP_CLIENT_ID=
NCP_CLIENT_SECRET=
SERVICE_ACCOUNT_FILE=
PROJECT_ID=
